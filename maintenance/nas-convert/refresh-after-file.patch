+
+# Resume a previously interrupted retry against the actual output, not the deleted original.
+with queue_case([{"file": "old.mkv", "output_file": "old.mp4", "status": "running",
+                  "percent": 70, "method": "av1"}]) as (root, state, saved):
+    (root / "old.mp4").write_bytes(b"src")
+    with patch.object(c, "convert_one", side_effect=lambda src, item, state, tracks: item.update(status="done")) as encode:
