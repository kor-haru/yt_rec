 """
 import json
 import tempfile
+from contextlib import contextmanager
 from datetime import datetime
 from pathlib import Path
+from unittest.mock import patch

 import convert_slot1_a as c

@@ -299,4 +301,247 @@ with tempfile.TemporaryDirectory() as tmp:
     finally:
         c.LOCK, c.SLOT6_LOCK, c.pid_alive, c.log = _lock, _slot, _alive, _log

+@contextmanager
+def queue_case(history=(), *, apple_tv=False):
+    """Exercise real scanning/queue logic without NAS access or media subprocesses."""
+    with tempfile.TemporaryDirectory() as tmp:
+        root = Path(tmp)
+        state = {"folder": str(root), "items": [dict(it) for it in history]}
+        saved = []
+        def capture(s):
+            if s is not state:
+                state.clear()
+                state.update(s)
+            saved.append(json.loads(json.dumps(s)))
+        with patch.multiple(
+            c, ROOT=root, LOCAL_DIR=root, MIN_SIZE=1, RECURSIVE=True,
+            APPLE_TV=apple_tv, CONVERTED_VIDEO=set(), map_drive=lambda: True,
+            load_state=lambda: state, save=capture,
+            log=lambda *_: None, error_log=lambda *_: None,
+            probe_video_codec=lambda _: "h264", probe_tracks=lambda _: [V(), A(1)],
+            apple_tv_ready=lambda _: False, probe_video_codec_tag=lambda _: ("h264", "avc1"),
+            file_settled=lambda *_: True,
+        ):
+            yield root, state, saved
+
+
+# New files append after the existing queue, including additions during its last item.
+# Renamed outputs are not new videos even when CONVERTED_VIDEO is empty in a custom launcher.
+with queue_case() as (root, state, saved):
+    (root / "first.mkv").write_bytes(b"x" * 20)
+    (root / "second.mkv").write_bytes(b"x" * 10)
+    order = []
+    def convert_for_queue(src, item, _state, tracks=None):
+        order.append(c.video_key(src))
+        if src.name == "first.mkv":
+            (root / "nested").mkdir()
+            (root / "nested" / "new.mkv").write_bytes(b"x" * 30)
+        if src.name == "new.mkv":
+            (root / "last.mkv").write_bytes(b"x" * 40)
+        dest = src.with_suffix(".mp4")
+        src.replace(dest)
+        item.update(status="done", method="av1", dst_bytes=dest.stat().st_size,
+                    output_file=c.video_key(dest))
+    with patch.object(c, "convert_one", convert_for_queue):
+        assert c.run_pass() == 0
+    assert order == ["first.mkv", "second.mkv", str(Path("nested") / "new.mkv"), "last.mkv"], order
+    assert len(state["items"]) == 4 and state["summary"]["done"] == 4, state
+    assert any(s["summary"]["pending"] == 2 and len(s["items"]) == 3 for s in saved)
+    with patch.object(c, "convert_one", side_effect=AssertionError("output requeued after restart")):
+        assert c.run_pass() == 0
+    assert len(state["items"]) == 4
+
+
+# Pre-patch history is migrated only when a missing source has an output of the recorded size.
+# Failed/skipped entries and distinct same-stem files remain independent.
+with queue_case([
+    {"file": "old.mkv", "status": "done", "method": "av1", "dst_bytes": 7},
+    {"file": "bad.mkv", "status": "failed", "error": "EBML header parsing failed"},
+    {"file": "skip.mp4", "status": "skipped", "error": "missing"},
+    {"file": "same.mkv", "status": "done", "method": "av1", "dst_bytes": 3},
+    {"file": "wrong.mkv", "status": "done", "method": "av1", "dst_bytes": 100},
+]) as (root, state, saved):
+    for name, size in (("old.mp4", 7), ("bad.mkv", 6), ("skip.mp4", 5),
+                       ("same.mkv", 4), ("same.mp4", 3), ("wrong.mp4", 2)):
+        (root / name).write_bytes(b"x" * size)
+    order = []
+    def mark_done(src, item, _state, tracks=None):
+        order.append(src.name)
+        item.update(status="done", method="av1", output_file=c.video_key(src))
+    with patch.object(c, "convert_one", mark_done):
+        c.run_pass()
+    assert order == ["same.mp4", "wrong.mp4"], order
+    assert state["items"][0]["output_file"] == "old.mp4"
+    assert state["items"][1]["error"] == "EBML header parsing failed"
+    assert state["items"][2]["error"] == "missing"
+
+
+# An aliased AV1 output is still eligible for the existing Apple TV retry policy.
+with queue_case([{"file": "old.mkv", "output_file": "old.mp4", "status": "done",
+                  "method": "av1", "dst_bytes": 3}], apple_tv=True) as (root, state, saved):
+    (root / "old.mp4").write_bytes(b"src")
+    retried = []
+    def apple_retry(src, item, _state, tracks=None):
+        retried.append(src.name)
+        item.update(status="done", method="hevc", output_file=c.video_key(src))
+    with patch.object(c, "convert_one", apple_retry):
+        c.run_pass()
