+
+
+# Resume keeps persisted FIFO even when a newly appended file is larger than remaining inputs.
+with queue_case() as (root, state, saved):
+    (root / "first.mkv").write_bytes(b"x" * 100)
+    (root / "second.mkv").write_bytes(b"x" * 10)
+    order = []
+    def append_before_pause(src, item, _state, tracks=None):
+        order.append(src.name)
+        item["status"] = "done"
+        (root / "new.mkv").write_bytes(b"x" * 30)
+    with patch.object(c, "convert_one", append_before_pause):
+        c.run_pass(lambda: "pause after refresh" if len(state["items"]) == 3 else "")
+    assert order == ["first.mkv"]
+    assert [it["file"] for it in state["items"] if it["status"] == "pending"] == ["second.mkv", "new.mkv"]
+    # Also append a still larger file discovered for the first time on restart.
+    (root / "restart.mkv").write_bytes(b"x" * 200)
+    def resume_in_order(src, item, _state, tracks=None):
+        order.append(src.name)
+        item["status"] = "done"
+    with patch.object(c, "convert_one", resume_in_order):
+        c.run_pass()
+    assert order == ["first.mkv", "second.mkv", "new.mkv", "restart.mkv"], order
+
+
+# Stop/yield after a completed file must not launch (or scan for) the following file.
+with queue_case() as (root, state, saved):
+    (root / "first.mkv").write_bytes(b"xx")
+    (root / "second.mkv").write_bytes(b"x")
+    calls = []
+    def stop_after_one(src, item, _state, tracks=None):
+        calls.append(src.name)
+        item["status"] = "done"
+    with patch.object(c, "convert_one", stop_after_one), patch.object(c, "list_videos", wraps=c.list_videos) as scans:
+        c.run_pass(lambda: "stop requested" if calls else "")
+    assert calls == ["first.mkv"] and scans.call_count == 1
+    assert state["summary"]["pending"] == 1
+
+
+# A changing newly appended file remains pending across restart, not failed or forgotten.
+with queue_case() as (root, state, saved):
+    (root / "first.mkv").write_bytes(b"xx")
+    order = []
+    def add_copy(src, item, _state, tracks=None):
+        order.append(src.name)
+        item["status"] = "done"
+        (root / "copying.mkv").write_bytes(b"x")
+    with patch.object(c, "convert_one", add_copy), patch.object(c, "file_settled", return_value=False):
+        c.run_pass()
+    assert order == ["first.mkv"] and state["summary"]["pending"] == 1
+    copying = state["items"][1]
+    assert copying["awaiting_stability"] and copying["status"] == "pending"
+    assert "finished_at" not in state
+    with patch.object(c, "convert_one", side_effect=AssertionError("unstable copy resumed")), \
+            patch.object(c, "file_settled", return_value=False) as settled:
+        c.run_pass()
+    assert settled.call_count == 1 and copying["status"] == "pending"
+    def finish_copy(src, item, _state, tracks=None):
+        item["status"] = "done"
+    with patch.object(c, "convert_one", finish_copy):
+        c.run_pass()
+    assert copying["status"] == "done" and "awaiting_stability" not in copying
+
+
+# Failure is also a processed-file boundary; its history is retained and never loops in-pass.
+with queue_case() as (root, state, saved):
+    (root / "bad.mkv").write_bytes(b"xx")
+    order = []
+    def fail_then_add(src, item, _state, tracks=None):
+        order.append(src.name)
+        if src.name == "bad.mkv":
+            item.update(status="failed", error="EBML header parsing failed")
+            (root / "new.mkv").write_bytes(b"x")
+        else:
+            item["status"] = "done"
+    with patch.object(c, "convert_one", fail_then_add):
+        c.run_pass()
+    assert order == ["bad.mkv", "new.mkv"] and state["summary"]["failed"] == 1
+
+
+# Existing one-time skip retries must still reach the encoder.
+with queue_case([{"file": "old.mkv", "status": "skipped",
+                  "error": "AV1 larger than original by >=10% (src=1 dst=2)"}]) as (root, state, saved):
