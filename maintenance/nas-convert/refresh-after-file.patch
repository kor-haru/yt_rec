+        assert item["status"] == "done" and item["output_file"] == "encode.mp4", item
+        assert not src.exists() and (root / "encode.mp4").read_bytes() == b"done"
+        src = root / "remux.mkv"
+        src.write_bytes(b"x" * 10)
+        item = {"file": src.name, "status": "skipped"}
+        state["items"].append(item)
+        c.remux_one(src, item, state)
+        assert item["status"] == "done" and item["output_file"] == "remux.mp4", item
