+
+
+# Legacy foreign-container encodes with extra tracks produced MKV, not MP4.
+with queue_case([{"file": "old.avi", "status": "done", "method": "av1", "dst_bytes": 3}]) as (root, state, saved):
+    assert c.result_suffix(".avi", True) == ".mkv"
+    (root / "old.mkv").write_bytes(b"src")
+    with patch.object(c, "convert_one", side_effect=AssertionError("legacy MKV output requeued")):
+        c.run_pass()
+    assert len(state["items"]) == 1 and state["items"][0]["output_file"] == "old.mkv"
+
+
+# Two possible same-sized legacy outputs are ambiguous: neither independent source is suppressed.
+with queue_case([{"file": "old.avi", "status": "done", "method": "av1", "dst_bytes": 3}]) as (root, state, saved):
+    (root / "old.mkv").write_bytes(b"src")
+    (root / "old.mp4").write_bytes(b"src")
+    with patch.object(c, "convert_one", side_effect=lambda src, item, state, tracks: item.update(status="done")) as encode:
+        c.run_pass()
