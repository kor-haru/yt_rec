+        free_bytes=lambda: 10**12, probe_media=lambda _: (60, 1000),
+        probe_video_shape=lambda _: (1920, 1080, "30/1", "30/1"), probe_starts=lambda _: (0, 0),
+        probe_duration=lambda _: 60, probe_frames=lambda _: 1800, run_ffmpeg=encoded,
+    ):
